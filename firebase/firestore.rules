rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============== HELPER FUNCTIONS ==============
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the owner of a resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Check if user is a member of the family
    function isFamilyMember(familyId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }
    
    // Check if user is an admin of the family
    function isFamilyAdmin(familyId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid
      );
    }

    // True when the requester has a membership document in one of the
    // families listed on another user's profile. `familyIds` is written by
    // its owner, so it is only trusted as a list of candidates; membership
    // documents can only be created by Cloud Functions. Rules cannot loop, so
    // the first few nests are checked, which covers every realistic user.
    function sharesFamilyWithProfile(profile) {
      let fids = profile.get('familyIds', []);
      return (fids.size() > 0 && isFamilyMember(fids[0])) ||
        (fids.size() > 1 && isFamilyMember(fids[1])) ||
        (fids.size() > 2 && isFamilyMember(fids[2])) ||
        (fids.size() > 3 && isFamilyMember(fids[3])) ||
        (fids.size() > 4 && isFamilyMember(fids[4]));
    }

    // A member leaving may take only themselves off `memberIds`.
    function isRemovingOnlySelf() {
      let before = resource.data.get('memberIds', []);
      let after = request.resource.data.get('memberIds', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
        before.removeAll(after).hasOnly([request.auth.uid]) &&
        after.removeAll(before).size() == 0;
    }
    
    // ============== APP CONFIG ==================
    
    match /app_config/{document=**} {
      // Anyone can read app configuration (like updates)
      allow read: if true;
      allow write: if false; // Only admins from console can write
    }

    // ============== USERS COLLECTION ==============
    
    match /users/{userId} {
      // Profiles hold phone numbers, so only the owner and people who share a
      // nest with them may read one.
      allow read: if isAuthenticated() && (
        isOwner(userId) || sharesFamilyWithProfile(resource.data)
      );
      
      // Only the owner can create or update their profile. The account
      // deletion schedule is managed by the requestAccountDeletion and
      // cancelAccountDeletion Cloud Functions.
      allow create: if isOwner(userId) &&
        !request.resource.data.keys().hasAny(['deletionRequestedAt', 'deletionScheduledFor']);
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['deletionRequestedAt', 'deletionScheduledFor']);
      
      // Prevent deletion (soft delete only)
      allow delete: if false;
      
      // User settings subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ============== FAMILIES COLLECTION ==============
    
    match /families/{familyId} {
      // Invite-code lookups run in the joinFamily Cloud Function, so nobody
      // outside the nest needs to read it.
      allow read: if isFamilyMember(familyId);
      
      // Created by the createFamily Cloud Function together with the
      // creator's admin membership.
      allow create: if false;
      
      // Admins edit the nest; a member leaving may remove only themselves.
      // Invite codes are rotated by the generateInviteCode Cloud Function.
      allow update: if isFamilyAdmin(familyId) || (isAuthenticated() && isRemovingOnlySelf());
      
      // Only admins can delete family (with safeguards)
      allow delete: if isFamilyAdmin(familyId);
      
      // Members subcollection
      match /members/{memberId} {
        // Any family member can read the member list, or user can read their own membership status
        allow read: if isAuthenticated() && (isFamilyMember(familyId) || memberId == request.auth.uid);
        
        // A membership document is what grants access to a nest's locations,
        // so only the createFamily / joinFamily Cloud Functions create them.
        allow create: if false;
        
        // Admins can update anyone; members can edit their own details but
        // not promote themselves.
        allow update: if isFamilyAdmin(familyId) || (
          isAuthenticated() &&
          memberId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'userId'])
        );
        
        // Admins can remove members, members can remove themselves
        allow delete: if isAuthenticated() && (
          isFamilyAdmin(familyId) || 
          memberId == request.auth.uid
        );
      }
      
      // Geofences subcollection
      match /geofences/{geofenceId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isFamilyAdmin(familyId);
      }
      
      // Geofence events subcollection
      match /geofence_events/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId);
        allow update, delete: if false; // Events are immutable
      }
    }
    
    // ============== INVITES COLLECTION ==============
    
    match /invites/{inviteCode} {
      // Unused by the app; joining goes through the joinFamily function.
      allow read: if isFamilyMember(resource.data.familyId);
      
      // Only family admins can create invites
      allow create: if isAuthenticated() && 
        isFamilyAdmin(request.resource.data.familyId);
      
      // Invites are immutable
      allow update: if false;
      
      // Only family admins can delete invites
      allow delete: if isFamilyAdmin(resource.data.familyId);
    }
    
    // ============== SOS EVENTS COLLECTION ==============
    
    match /sos_events/{eventId} {
      // Family members can read SOS events
      allow read: if isFamilyMember(resource.data.familyId);
      
      // Family members can create SOS events
      allow create: if isAuthenticated() && 
        isFamilyMember(request.resource.data.familyId) &&
        request.resource.data.userId == request.auth.uid;
      
      // Family members can update (respond to) SOS events
      allow update: if isFamilyMember(resource.data.familyId);
      
      // SOS events cannot be deleted
      allow delete: if false;
    }
    
    // ============== NOTIFICATIONS COLLECTION ==============
    
    match /notifications/{userId}/items/{notificationId} {
      // Users can only read their own notifications
      allow read: if isOwner(userId);
      
      // Cloud Functions use the admin SDK and bypass these rules. Clients may
      // only write into their own inbox, otherwise anyone could push fake
      // alerts (including SOS) into another member's notification list.
      allow create: if isOwner(userId);
      
      // Users can update (mark as read) their notifications
      allow update: if isOwner(userId);
      
      // Users can delete their notifications
      allow delete: if isOwner(userId);
    }
    
    // ============== LOCATION HISTORY COLLECTION ==============
    // Live history is kept in Realtime Database; this collection only exists
    // for exports written by the owning device.
    
    match /location_history/{userId}/{date}/{docId} {
      allow read: if isOwner(userId);
      
      // Only the owner can write their location history
      allow write: if isOwner(userId);
    }
  }
}
