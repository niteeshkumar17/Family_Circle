{
  "rules": {
    ".read": false,
    ".write": false,

    "family_members": {
      "$familyId": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        "$userId": {
          ".write": "auth != null && auth.uid == $userId && !newData.exists()",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "locations": {
      "$familyId": {
        ".read": "auth != null && root.child('family_members').child($familyId).child(auth.uid).exists()",
        "$userId": {
          ".write": "auth != null && auth.uid == $userId",
          ".validate": "newData.hasChildren(['latitude', 'longitude', 'timestamp']) && newData.child('latitude').isNumber() && newData.child('longitude').isNumber() && newData.child('timestamp').isNumber()"
        }
      }
    },

    "presence": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $userId"
      }
    },

    "sos_active": {
      "$familyId": {
        ".read": "auth != null && root.child('family_members').child($familyId).child(auth.uid).exists()",
        "$eventId": {
          ".write": "auth != null && root.child('family_members').child($familyId).child(auth.uid).exists()"
        }
      }
    },

    "typing_indicators": {
      "$familyId": {
        ".read": "auth != null && root.child('family_members').child($familyId).child(auth.uid).exists()",
        "$userId": {
          ".write": "auth != null && auth.uid == $userId"
        }
      }
    },

    "locationHistory": {
      "$familyId": {
        ".read": "auth != null && root.child('family_members').child($familyId).child(auth.uid).exists()",
        "$userId": {
          ".write": "auth != null && auth.uid == $userId"
        }
      }
    },

    "geofence_states": {
      ".read": false,
      ".write": false
    },

    "low_battery_alerts": {
      ".read": false,
      ".write": false
    },

    "wakeAttempts": {
      ".read": false,
      ".write": false
    },

    "joinAttempts": {
      ".read": false,
      ".write": false
    }
  }
}
